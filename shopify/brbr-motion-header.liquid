{% comment %}
  brbr.co motion header
  1. Upload app/public/assets/shopify/brbr-motion-header.mp4 in Shopify admin: Content > Files (or pick it in the "Video" setting).
  2. Online Store > Themes > Edit code > Sections > Add a new section "brbr-motion-header" and paste this file.
  3. Customise the home page > Add section > "brbr motion header".
{% endcomment %}
<section class="brbr-mh" style="--mh-h: {{ section.settings.height }}vh;">
  {%- if section.settings.video != blank -%}
    {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, class: 'brbr-mh__v', image_size: '1920x' }}
  {%- elsif section.settings.video_url != blank -%}
    <video class="brbr-mh__v" autoplay muted loop playsinline preload="metadata" {% if section.settings.poster != blank %}poster="{{ section.settings.poster | image_url: width: 1920 }}"{% endif %}><source src="{{ section.settings.video_url }}" type="video/mp4"></video>
  {%- endif -%}
  {%- if section.settings.poster != blank -%}{{ section.settings.poster | image_url: width: 1920 | image_tag: class: 'brbr-mh__poster', alt: section.settings.heading, loading: 'eager' }}{%- endif -%}
  <div class="brbr-mh__shade" aria-hidden="true"></div>
  <div class="brbr-mh__copy page-width">
    {%- if section.settings.eyebrow != blank -%}<p class="brbr-mh__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="brbr-mh__title">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<p class="brbr-mh__text">{{ section.settings.text }}</p>{%- endif -%}
    {%- if section.settings.button_label != blank -%}<a class="brbr-mh__btn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>{%- endif -%}
  </div>
</section>
<style>
  .brbr-mh{position:relative;min-height:var(--mh-h,78vh);display:grid;align-items:end;overflow:hidden;background:#0b0b0c;color:#f4efe7;isolation:isolate}
  .brbr-mh__v,.brbr-mh__poster{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-2}.brbr-mh__poster{z-index:-3}
  .brbr-mh__shade{position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,rgba(11,11,12,.88) 0%,rgba(11,11,12,.45) 45%,rgba(11,11,12,0) 75%),linear-gradient(0deg,rgba(11,11,12,.7),rgba(11,11,12,0) 40%)}
  .brbr-mh__copy{padding-top:120px;padding-bottom:clamp(48px,9vh,96px);display:grid;gap:18px;max-width:720px}
  .brbr-mh__eyebrow{margin:0;font-size:.78rem;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:#e8a15a}
  .brbr-mh__title{margin:0;font-size:clamp(2.6rem,6.4vw,6rem);line-height:.9;font-weight:900;text-transform:uppercase;color:#f4efe7}
  .brbr-mh__text{margin:0;font-size:clamp(1rem,1.3vw,1.15rem);line-height:1.6;color:#c9c3ba;max-width:52ch}
  .brbr-mh__btn{justify-self:start;display:inline-flex;align-items:center;min-height:52px;padding:0 1.6em;border-radius:999px;background:#e8a15a;color:#17130f;font-weight:700;text-decoration:none;transition:transform .2s ease,background-color .2s ease}
  .brbr-mh__btn:hover{background:#f5bd80;transform:translateY(-2px)}
  @media (prefers-reduced-motion:reduce){.brbr-mh__v{display:none}}
</style>
{% schema %}
{"name":"brbr motion header","tag":"div","settings":[{"type":"video","id":"video","label":"Video (Shopify-hosted)"},{"type":"url","id":"video_url","label":"Or video URL (.mp4)"},{"type":"image_picker","id":"poster","label":"Poster image"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Official UK stock"},{"type":"text","id":"heading","label":"Heading","default":"Gummy hair wax & barber essentials"},{"type":"textarea","id":"text","label":"Text","default":"Gummy Professional and The Shave Factory, dispatched from our UK warehouse the next working day."},{"type":"text","id":"button_label","label":"Button label","default":"Shop the range"},{"type":"url","id":"button_link","label":"Button link"},{"type":"range","id":"height","label":"Height (% of screen)","min":50,"max":100,"step":2,"unit":"%","default":78}],"presets":[{"name":"brbr motion header"}]}
{% endschema %}
